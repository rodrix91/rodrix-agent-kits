---
import { t, asset, type Lang } from '../lib/i18n';
import { NEWSLETTER, BRAND } from '../config';
const { lang } = Astro.props as { lang: Lang };
const s = t[lang].news;
const live = Boolean(NEWSLETTER.action);
---
<section class="section" id="newsletter" aria-labelledby="news-h">
  <div class="wrap">
    <div class="news reveal">
      <div>
        <span class="kicker">Newsletter</span>
        <h2 id="news-h">{s.title}</h2>
        <p style="margin:0">{s.sub}</p>
      </div>
      <div>
        <form class="nl-form" action={NEWSLETTER.action || '#'} method="post" target={live ? '_blank' : undefined} rel={live ? 'noopener noreferrer' : undefined} data-live={String(live)} data-sent={s.sent} data-soon={live ? undefined : s.soon}>
          <label class="nl-label" for={`nl-${lang}`}>{s.email}</label>
          <div class="nl-row">
            <input class="input" id={`nl-${lang}`} name={NEWSLETTER.emailField} type="email" autocomplete="email" required placeholder="you@domain.com" />
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
            <button class="btn btn-primary" type="submit" style="--h:48px">{s.submit}</button>
          </div>
        </form>
        <p class="status muted" role="status" aria-live="polite">{!live && s.soon}</p>
        {live && <p class="nl-privacy muted" data-nl-live>{s.privacy} <a href={NEWSLETTER.publicPage} rel="noopener">{s.alt}</a> · <a href={asset(lang === 'es' ? '/es/privacy/' : '/privacy/')}>{lang === 'es' ? 'Privacidad' : 'Privacy'}</a></p>}
        <p class="nl-fallback muted" data-nl-fallback={live ? undefined : ''} style="margin:.5rem 0 0">
          {live ? s.also : (lang === 'es' ? 'Mientras tanto:' : 'Meanwhile:')}{' '}
          <a href={asset(lang === 'es' ? '/es/rss.xml' : '/rss.xml')}>RSS</a>{' · '}
          <a href={BRAND.x} rel="noopener">X</a>
        </p>
      </div>
    </div>
  </div>
</section>
<script>
  // Progressive enhancement only: the form is a plain POST that works without JS.
  document.querySelectorAll<HTMLFormElement>('.nl-form').forEach((f) => {
    f.addEventListener('submit', (e) => {
      const st = f.parentElement!.querySelector('.status')!;
      if (f.dataset.live !== 'true') { e.preventDefault(); st.textContent = f.dataset.soon || ''; return; }
      if ((f.querySelector('input[name=website]') as HTMLInputElement).value) { e.preventDefault(); return; }
      st.textContent = f.dataset.sent!;
    });
  });
</script>
