---
import { t, url, asset, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const s = t[lang].finder;
---
<div class="finder" id="finder" data-index={asset(`/search-${lang}.json`)} data-base={url('/kits/', lang)} data-none={s.none} data-results={s.results}>
  <span class="kicker">{s.title}</span>
  <form id="finder-form" role="search">
    <label class="label" for="finder-q" style="flex-basis:100%">{s.label}</label>
    <input class="input" id="finder-q" name="q" type="search" placeholder={s.placeholder} autocomplete="off" />
    <button class="btn btn-primary" type="submit" style="--h:48px">{s.go}</button>
  </form>
  <div class="finder-out" id="finder-out" aria-live="polite"></div>
  <p class="muted" style="font-size:var(--t-xs);margin:1rem 0 0">{s.note}</p>
</div>
<script>
  import { rank } from '../lib/match';
  const root = document.getElementById('finder')!;
  const out = document.getElementById('finder-out')!;
  let idx: any[] | null = null;
  const load = async () => (idx ??= await (await fetch(root.dataset.index!)).json());
  document.getElementById('finder-q')!.addEventListener('focus', load, { once: true });
  document.getElementById('finder-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const q = (document.getElementById('finder-q') as HTMLInputElement).value;
    const res = rank(q, await load()).slice(0, 3);
    out.replaceChildren();
    if (!res.length) { const p = document.createElement('p'); p.textContent = root.dataset.none!; p.style.margin = '0'; out.append(p); return; }
    const h = document.createElement('p'); h.className = 'muted'; h.style.margin = '0'; h.textContent = root.dataset.results!; out.append(h);
    for (const r of res) {
      const a = document.createElement('a'); a.href = root.dataset.base + r.doc.slug + '/';
      const b = document.createElement('span'); b.textContent = r.doc.title;
      const sm = document.createElement('small'); sm.textContent = `${r.doc.tool} · ${Math.round(r.score * 100)}%`;
      a.append(b, sm); out.append(a);
    }
  });
</script>
