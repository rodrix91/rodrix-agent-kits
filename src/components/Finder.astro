---
import { t, url, asset, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const s = t[lang].finder;
---
<div class="finder" id="finder" data-index={asset(`/search-${lang}.json`)} data-base={url('/kits/', lang)} data-none={s.none} data-results={s.results} data-error={s.error}>
  <span class="kicker">{s.title}</span>
  <form id="finder-form" role="search">
    <label class="label" for="finder-q" style="flex-basis:100%">{s.label}</label>
    <input class="input" id="finder-q" name="q" type="search" placeholder={s.placeholder} autocomplete="off" />
    <button class="btn btn-primary" type="submit" style="--h:48px">{s.go}</button>
  </form>
  <div class="finder-out" id="finder-out" aria-live="polite"></div>
  <p class="muted" style="font-size:var(--t-xs);margin:1rem 0 0">{s.note}</p>
</div>
<script>
  import { rank, tokenize } from '../lib/match';
  const root = document.getElementById('finder')!;
  const out = document.getElementById('finder-out')!;
  let idx: any[] | null = null;
  let inFlight: Promise<any[]> | null = null;
  // Each submission supersedes earlier pending results and errors.
  let newestSearch = 0;
  const isKitRecord = (entry: unknown): boolean => {
    if (entry === null || typeof entry !== 'object') return false;
    const record = entry as Record<string, unknown>;
    // Kit URLs are built from slug values, while title, tool and text are
    // required for readable results and meaningful search ranking.
    if (typeof record.slug !== 'string' || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(record.slug)) return false;
    return ['title', 'tool', 'text'].every(
      (field) => typeof record[field] === 'string' && (record[field] as string).trim().length > 0,
    );
  };
  const load = (): Promise<any[]> => {
    if (idx) return Promise.resolve(idx);
    if (!inFlight) {
      inFlight = (async () => {
        const response = await fetch(root.dataset.index!);
        if (!response.ok) throw new Error('Kit index unavailable');
        const result: unknown = await response.json();
        if (!Array.isArray(result) || result.length === 0 || !result.every(isKitRecord)) throw new Error('Invalid kit index');
        idx = result;
        return result;
      })().finally(() => { inFlight = null; });
    }
    return inFlight;
  };
  // Fetch only after a meaningful search submission. Focusing the field
  // should not request a potentially large index when the query is blank.
  const showNoResults = () => {
    out.replaceChildren();
    const p = document.createElement('p');
    p.textContent = root.dataset.none!;
    p.style.margin = '0';
    out.append(p);
  };
  document.getElementById('finder-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const searchId = ++newestSearch;
    const q = (document.getElementById('finder-q') as HTMLInputElement).value;
    // A blank/stop-word query has no useful matches. Do not fetch the catalog
    // or surface a network error, and invalidate any earlier pending search.
    if (!tokenize(q).length) {
      showNoResults();
      return;
    }
    let catalog: any[];
    try {
      catalog = await load();
    } catch {
      if (searchId !== newestSearch) return;
      out.replaceChildren();
      const p = document.createElement('p');
      p.textContent = root.dataset.error!;
      p.style.margin = '0';
      out.append(p);
      return;
    }
    if (searchId !== newestSearch) return;
    const res = rank(q, catalog).slice(0, 3);
    out.replaceChildren();
    if (!res.length) { showNoResults(); return; }
    const h = document.createElement('p'); h.className = 'muted'; h.style.margin = '0'; h.textContent = root.dataset.results!; out.append(h);
    for (const r of res) {
      const a = document.createElement('a'); a.href = root.dataset.base + r.doc.slug + '/';
      const b = document.createElement('span'); b.textContent = r.doc.title;
      const sm = document.createElement('small'); sm.textContent = `${r.doc.tool} · ${Math.round(r.score * 100)}%`;
      a.append(b, sm); out.append(a);
    }
  });
</script>
