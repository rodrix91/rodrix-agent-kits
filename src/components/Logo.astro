---
const { size = 22 } = Astro.props;
---
<svg width={size * 6.4} height={size} viewBox="0 0 141 22" role="img" aria-label="Rodrix Agent Kits">
  <rect x="0.75" y="0.75" width="20.5" height="20.5" rx="6" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="1.5"/>
  <path d="M7 7l4 4-4 4" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  <rect x="12.5" y="14" width="4" height="1.9" rx=".9" fill="currentColor"/>
  <text x="30" y="16.2" font-family="Geist, ui-sans-serif, system-ui, sans-serif" font-size="16" font-weight="640" letter-spacing="-0.6" fill="currentColor">rodrix<tspan fill="var(--fg-3)" font-weight="450">/kits</tspan></text>
</svg>
