---
import Logo from './Logo.astro';
import { t, url, type Lang } from '../lib/i18n';
interface Props { lang: Lang; path: string; enOnly?: boolean }
const { lang, path, enOnly = false } = Astro.props;
const s = t[lang];
const other: Lang = lang === 'en' ? 'es' : 'en';
const links = [['/kits/', s.nav.kits], ['/pricing/', s.nav.pricing], ['/sponsors/', s.nav.sponsors], ['/about/', s.nav.about], ['/changelog/', s.nav.changelog]];
---
<header class="hdr" id="hdr">
  <div class="wrap">
    <a class="logo" href={url('/', lang)} aria-label="Rodrix Agent Kits — home"><Logo /></a>
    <nav class="nav" id="nav" aria-label="Main">
      {links.map(([p, label]) => <a href={url(p, lang)} aria-current={path.startsWith(p) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="hdr-tools">
      <a class="icon-btn" href={url(enOnly ? '/' : path, other)} hreflang={other} lang={other} aria-label={s.switchLang}>{other.toUpperCase()}</a>
      <button class="icon-btn" id="theme" type="button" aria-label={s.theme}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="icon-btn menu-btn" id="menu" type="button" aria-label={s.menu} aria-expanded="false" aria-controls="nav">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 17h16"/></svg>
      </button>
      <a class="btn btn-primary btn-sm" href={url('/kits/', lang)}>{s.cta.browse}</a>
    </div>
  </div>
</header>
<script>
  const h = document.getElementById('hdr')!;
  const onScroll = () => h.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
  document.getElementById('theme')!.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
  const m = document.getElementById('menu')!, n = document.getElementById('nav')!;
  m.addEventListener('click', () => { const o = n.classList.toggle('open'); m.setAttribute('aria-expanded', String(o)); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && n.classList.contains('open')) { n.classList.remove('open'); m.setAttribute('aria-expanded', 'false'); m.focus(); } });
  // reveal on scroll
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    els.forEach((el) => io.observe(el));
  } else els.forEach((el) => el.classList.add('in'));
</script>
