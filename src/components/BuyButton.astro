---
import { url, t, type Lang } from '../lib/i18n';
const { href, label, lang, primary = true } = Astro.props as { href: string; label: string; lang: Lang; primary?: boolean };
const s = t[lang];
---
{href
  ? <a class={`btn ${primary ? 'btn-primary' : ''} gumroad-button`} href={href} data-gumroad-overlay-checkout="true" rel="noopener">{label}</a>
  : <a class={`btn ${primary ? 'btn-primary' : ''}`} href={url('/#newsletter', lang)} aria-disabled="true" title="Checkout not live yet">{s.cta.soon}</a>}
{href && <script is:inline src="https://gumroad.com/js/gumroad.js" defer></script>}
