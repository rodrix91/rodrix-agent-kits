    {
      "parameters": {
        "jsCode": "// Inputs can become spreadsheet cells; keep untrusted text as text.\nconst sheetText = (value, maxLength) => {\n  const text = String(value ?? '').replace(/[\\u0000-\\u001f\\u007f]/g, ' ').trim();\n  // Leading =, +, -, @ are spreadsheet formula triggers.\n  return /^[=+\\-@]/.test(text) ? \"'\" + text.slice(0, maxLength - 1) : text.slice(0, maxLength);\n};\nconst out = [];\nfor (const item of $input.all()) {\n  const b = item.json.body ?? item.json;\n  const email = String(b.email ?? '').trim().toLowerCase();\n  const name = sheetText(b.name, 120);\n  const source = sheetText(b.source ?? 'site', 60);\n  const valid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email) && !/^[=+\\-@]/.test(email) && !b.website; // `website` = honeypot\n  out.push({ json: { valid, email, name, source, created_at: new Date().toISOString() } });\n}\nreturn out;"
      },
      "id": "a1f0c1e2-0002-4c1a-9a01-000000000002",
