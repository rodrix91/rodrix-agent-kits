---
import Base from '../layouts/Base.astro';
import KitCard from '../components/KitCard.astro';
import BuyButton from '../components/BuyButton.astro';
import Newsletter from '../components/Newsletter.astro';
import { t, url, asset, type Lang } from '../lib/i18n';
import { getKits, kitFile, buyUrl, bundlePending, SOON, type Kit } from '../lib/kits';
import { GUMROAD } from '../config';
import { render, getCollection } from 'astro:content';
const { lang, kit } = Astro.props as { lang: Lang; kit: Kit };
const s = t[lang], K = s.kit, d = kit.data, L = d[lang];
const { Content } = await render(kit);
const soon = bundlePending(kit);
const es = lang === 'es';
const inside = soon ? L.inside.map((i) => i.replace(/^Bundle: /, es ? 'Próximamente: ' : 'Coming soon: ')) : L.inside;
const buyLabel = soon ? (es ? 'Ver Full-stack Pro (kit de handoff próximamente)' : 'Get Full-stack Pro — handoff kit coming soon') : s.cta.buy;
const clubLabel = soon ? (es ? 'Kit Club (kit de handoff próximamente)' : 'Kit Club — handoff kit coming soon') : s.cta.club;
const src = kitFile(kit);
const lines = src.split('\n');
const preview = d.tier === 'paid' ? lines.slice(0, d.previewLines).join('\n') : src;
const fname = d.installPath.split('/').pop()!.replace(/^n8n.*/, d.file);
const related = (await getKits()).filter((k) => k.id !== kit.id && (k.data.tool === d.tool || k.data.category === d.category || k.data.keywords.some((w) => d.keywords.includes(w)))).slice(0, 3);
const href = buyUrl(kit);
const origin = Astro.site!.origin;
const pageUrl = origin + url(`/kits/${kit.id}/`, lang);
const product = {
  '@context': 'https://schema.org', '@type': 'Product', name: L.title, description: L.summary, url: pageUrl, image: origin + asset(`/og/${kit.id}.png`),
  brand: { '@type': 'Brand', name: 'Rodrix Agent Kits' }, category: `${d.tool} / ${d.category}`,
  offers: { '@type': 'Offer', price: d.tier === 'free' ? '0' : String(d.price), priceCurrency: 'USD', availability: soon ? 'https://schema.org/PreOrder' : d.tier === 'free' || href ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder', url: d.tier === 'free' ? pageUrl : href || pageUrl },
};
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: origin + url('/', lang) },
  { '@type': 'ListItem', position: 2, name: s.nav.kits, item: origin + url('/kits/', lang) },
  { '@type': 'ListItem', position: 3, name: L.title, item: pageUrl }] };
const compatDefault: Record<string, string> = {
  'Cursor': 'It is written for Cursor. The rules are plain Markdown, so you can copy them into AGENTS.md or CLAUDE.md for other agents.',
  'Claude Code': 'CLAUDE.md is read by Claude Code. The content is plain Markdown, so you can copy it into AGENTS.md for Codex and other agents.',
  'Codex / any agent': 'Yes. AGENTS.md is an open format read by Codex, Cursor and other agents; Claude Code can import it from CLAUDE.md with a line @AGENTS.md.',
  'n8n': 'It is an n8n workflow (JSON) you import into n8n, not an agent rules file.',
  'Agent Skills': 'It follows the Agent Skills SKILL.md format; it works with agents that support skills.',
};
const bundleName = d.product ? d.product.split('-').map((w) => w[0].toUpperCase() + w.slice(1)).join(' ') : '';
const faq = [
  [`Where do I put this ${d.tool} file?`, `Save it as ${d.installPath} in your project root and restart/reload ${d.tool}.`],
  ['Is this kit free?', d.tier === 'free' ? 'Yes, MIT-licensed.' : soon ? `The ${fname} template is free. The full kit is coming to ${bundleName} ($${d.price}) and Kit Club; it is not included in them yet.` : `The preview is free; the full kit is part of ${bundleName} for $${d.price}.`],
  ['Does it work with other agents?', d.compat ?? compatDefault[d.tool]],
];
const graph = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'SoftwareSourceCode', name: L.title, description: L.summary, programmingLanguage: d.file.endsWith('.json') ? 'JSON' : 'Markdown', codeRepository: 'https://github.com/rodrix91/rodrix-agent-kits', license: 'https://opensource.org/licenses/MIT', url: pageUrl,
    targetProduct: { '@type': 'SoftwareApplication', name: d.tool, applicationCategory: 'DeveloperApplication', operatingSystem: 'Windows, macOS, Linux' } },
  { '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }] };
const guidesAll = (await getCollection(lang === 'es' ? 'guidesEs' : 'guides')).filter((g) => g.data.kits.includes(kit.id));
const guides = guidesAll.length ? guidesAll : (await getCollection('guides')).filter((g) => g.data.kits.includes(kit.id));
const guidesLang: Lang = guidesAll.length ? lang : 'en';
const date = d.added.toISOString().slice(0, 10);
---
<Base title={L.title} description={L.summary} lang={lang} path={`/kits/${kit.id}/`} og={`/og/${kit.id}.png`} jsonLd={[product, crumbs, graph]} type="article" gumroad={d.tier === 'paid'}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={url('/', lang)}>Home</a><span aria-hidden="true">/</span><a href={url('/kits/', lang)}>{s.nav.kits}</a><span aria-hidden="true">/</span><span aria-current="page">{L.title}</span></nav>
    <div class="kit-layout">
      <article>
        <div style="display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1.2rem">
          <span class="tag">{d.tool}</span><span class="tag">{d.category}</span>
          {d.languages.map((l) => <span class="tag">{l.toUpperCase()}</span>)}
          <span class={d.tier === 'free' ? 'tag tag-accent' : 'tag'}>{d.tier === 'free' ? K.freeLabel : soon ? SOON[lang] : K.paidLabel}</span>
        </div>
        <h1>{L.title}</h1>
        <p style="font-size:var(--t-md)">{L.summary}</p>
        {soon && <p class="answer" data-soon-note><strong>{SOON[lang]}.</strong> {es ? 'Hoy no está incluido en ningún bundle. La plantilla HANDOFF.md de abajo es gratis.' : 'It is not inside any bundle today. The HANDOFF.md template below is free.'}</p>}
        {d.tier === 'paid' && <div class="buy-top" data-testid="buy-top"><span class="price" style="font-size:var(--t-lg)">{soon ? 'Full-stack Pro ' : ''}${d.price} <small>{lang === 'es' ? 'pago único' : 'one-time'}</small></span><BuyButton href={href} label={buyLabel} lang={lang} /></div>}
        <div class="prose" lang="en"><Content /></div>
        <h2 style="font-size:var(--t-lg);margin-top:2.5rem">{K.inside}</h2>
        <ul class="check">{inside.map((i) => <li>{i}</li>)}</ul>
        <h2 style="font-size:var(--t-lg);margin-top:2.5rem">{K.file}</h2>
        <div class="code">
          <div class="code-head"><span>{fname}</span>
            <span style="display:flex;gap:.4rem">
              <button class="btn btn-sm copy" type="button" data-target="kit-src" data-done={s.cta.copied}>{s.cta.copy}</button>
              <a class="btn btn-sm" href={asset(`/files/${d.file}`)} download={d.file}>{s.cta.download}</a>
            </span>
          </div>
          <pre tabindex="0" aria-label={K.file}><code id="kit-src">{preview}</code></pre>
        </div>
        {guides.length > 0 && <section aria-labelledby="guides-h" lang={guidesLang}><h2 id="guides-h" style="font-size:var(--t-lg);margin-top:2.5rem">{lang === 'es' ? (guidesLang === 'es' ? 'Guías' : 'Guías (en inglés)') : 'Guides'}</h2><ul>{guides.map((g) => <li><a href={url(`/guides/${g.id}/`, guidesLang)}>{g.data.title}</a></li>)}</ul></section>}
        <section aria-labelledby="faq-h" lang="en"><h2 id="faq-h" style="font-size:var(--t-lg);margin-top:2.5rem">FAQ</h2>
          <dl class="faq">{faq.map(([q, a]) => <><dt style="font-weight:600;margin-top:1rem">{q}</dt><dd style="margin:.25rem 0 0">{a}</dd></>)}</dl>
        </section>
        {d.tier === 'paid' && <p class="muted" style="margin-top:1rem;font-size:var(--t-sm)">{soon ? (es ? 'La plantilla HANDOFF.md se puede usar sola. El hook, el prompt y el snippet llegarán a Full-stack Pro y Kit Club; aún no están incluidos.' : 'The HANDOFF.md template is usable on its own. The hook, prompt and snippet are coming to Full-stack Pro and Kit Club; they are not included yet.') : K.paidNote}</p>}
      </article>
      <aside class="aside">
        <div class="card">
          {d.tier === 'free'
            ? <><div class="price">$0 <small>MIT</small></div><p style="font-size:var(--t-sm)">{lang === 'es' ? 'Gratis para siempre. Copia el archivo y listo.' : 'Free forever. Copy the file and go.'}</p>
                <button class="btn btn-primary copy" type="button" data-target="kit-src" data-done={s.cta.copied} style="width:100%">{s.cta.copy}</button></>
            : <><div class="price">{soon ? 'Full-stack Pro ' : ''}${d.price} <small>{lang === 'es' ? 'pago único' : 'one-time'}</small></div><p style="font-size:var(--t-sm)">{soon ? SOON[lang] + (es ? '. Aún no incluido.' : '. Not included yet.') : lang === 'es' ? 'O inclúyelo en Kit Club por $7/mes.' : 'Or get it in Kit Club for $7/mo.'}</p>
                <div style="display:grid;gap:.5rem"><BuyButton href={href} label={buyLabel} lang={lang} /><BuyButton href={GUMROAD.kitClub} label={clubLabel} lang={lang} primary={false} /></div></>}
        </div>
        <div class="card">
          <dl class="dl">
            <div><dt>{K.install}</dt><dd><code>{d.installPath}</code></dd></div>
            <div><dt>{K.tested}</dt><dd>{d.tested}</dd></div>
            <div><dt>{K.updated}</dt><dd><time datetime={date}>{date}</time></dd></div>
          </dl>
        </div>
      </aside>
    </div>
    {related.length > 0 && <section class="section" aria-labelledby="rel-h" style="padding-bottom:0"><h2 id="rel-h">{K.related}</h2><div class="grid grid-3">{related.map((k) => <KitCard kit={k} lang={lang} />)}</div></section>}
  </div>
  <Newsletter lang={lang} />
</Base>
<script>
  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((b) => b.addEventListener('click', async () => {
    const txt = document.getElementById(b.dataset.target!)!.textContent!;
    const orig = b.textContent;
    try { await navigator.clipboard.writeText(txt); b.textContent = '✓ ' + b.dataset.done; } catch { b.textContent = 'Select & copy (Ctrl+C)'; }
    setTimeout(() => (b.textContent = orig), 1800);
  }));
</script>
