---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url, asset, type Lang } from '../lib/i18n';
import { BRAND, GUMROAD, GOOGLE_SITE_VERIFICATION, BING_SITE_VERIFICATION } from '../config';
interface Props { title: string; description: string; lang: Lang; path: string; og?: string; jsonLd?: object[]; noindex?: boolean; type?: string; gumroad?: boolean }
const { title, description, lang, path, og = '/og/default.png', jsonLd = [], noindex = false, type = 'website', gumroad = false } = Astro.props;
const site = Astro.site!.origin;
const canonical = site + url(path, lang);
const alt = (l: Lang) => site + url(path, l);
const ogUrl = site + asset(og);
const fullTitle = path === '/' ? title : `${title} — ${BRAND.name}`;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: BRAND.name, url: site + url('/', 'en'), logo: site + asset('/favicon.svg'), sameAs: [BRAND.x, BRAND.github] };
const ld = [org, ...jsonLd];
---
<!doctype html>
<html lang={lang} data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content="__CSP__" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={alt('en')} />
  <link rel="alternate" hreflang="es" href={alt('es')} />
  <link rel="alternate" hreflang="x-default" href={alt('en')} />
  <link rel="alternate" type="application/rss+xml" title="Rodrix Agent Kits" href={site + asset(lang === 'es' ? '/es/rss.xml' : '/rss.xml')} />
  <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
  {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
  {BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />}
  <meta name="theme-color" content="#08090b" />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={BRAND.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogUrl} />
  <script is:inline>(function(){try{var t=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');document.documentElement.dataset.theme=t}catch(e){}})()</script>
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  {gumroad && GUMROAD.overlay && <script is:inline src="https://gumroad.com/js/gumroad.js" defer></script>}
</head>
<body>
  <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
  <Header lang={lang} path={path} />
  <main id="main"><slot /></main>
  <Footer lang={lang} />
</body>
</html>
